# ==============================================================================
# LabelLens Root Environment Template
# Copy this to server/.env and client/.env accordingly
# ==============================================================================

# --- BACKEND (server/.env) ---
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,https://labellens.app,https://www.labellens.app
CLIENT_URL=http://localhost:5173

# Database & AI
MONGODB_URI=mongodb://localhost:27017/labellens
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# Auth & Security
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Azure Storage (Optional)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=label-scans

# --- FRONTEND (client/.env) ---
VITE_API_URL=http://localhost:5000
