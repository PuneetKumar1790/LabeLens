# ==============================================================================
# LabelLens Server Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,https://labellens.app,https://www.labellens.app

# Frontend URL (used for OAuth redirect callbacks)
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# MongoDB Database Configuration (Required for history, auth & preferences)
# ------------------------------------------------------------------------------
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/labellens?retryWrites=true&w=majority
# Example Local URI: mongodb://localhost:27017/labellens
MONGODB_URI=mongodb://localhost:27017/labellens

# ------------------------------------------------------------------------------
# Groq AI Configuration (Required for nutrition & vision analysis)
# ------------------------------------------------------------------------------
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# Authentication & JWT Secrets (Required for user sessions)
# ------------------------------------------------------------------------------
# Generate a secure random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Optional: needed only for Google Sign-In)
# ------------------------------------------------------------------------------
# Create credentials in Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# Azure Blob Storage (Optional: only needed if saving user scan images in cloud)
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=label-scans
